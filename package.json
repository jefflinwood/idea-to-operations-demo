{
  "name": "idea-to-operations-demo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Jeff Linwood",
  "scripts": {
    "dev": "wrangler dev --port 18800",
    "deploy": "wrangler deploy",
    "types": "wrangler types && pnpm --dir mergiraf-spike types",
    "typecheck": "tsc --noEmit && pnpm --dir mergiraf-spike typecheck",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "pack-demo": "node --experimental-strip-types scripts/pack-demo.ts",
    "setup": "node scripts/setup.mjs",
    "dev:merge": "pnpm --dir mergiraf-spike dev",
    "deploy:merge": "pnpm --dir mergiraf-spike deploy",
    "seed:local": "node --env-file=.dev.vars --experimental-strip-types scripts/demo-seed.mjs",
    "reset": "bash scripts/reset-demo.sh"
  },
  "dependencies": {
    "@zebric/mcp-server": "0.9.0",
    "@zebric/runtime-core": "0.9.0",
    "@zebric/runtime-worker": "0.9.0",
    "agents": "^0.26.0",
    "isomorphic-git": "^1.30.0",
    "memfs": "^4.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
